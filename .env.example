# Copiar para `.env.local` (não versionado) e preencher conforme necessário.
# Todas as variáveis do cliente têm de começar por `VITE_`.

# Base absoluta usada para gerar o link do QR code do cardápio
# (src/components/menu-qr-dialog.tsx). Em dev, o IP desta máquina na rede
# local para o QR poder ser lido pelo telemóvel.
VITE_PUBLIC_BASE_URL=http://192.168.1.194:8081

# Proxy de redimensionamento de imagens (src/lib/image-cdn.ts).
# Sem valor = identidade (nenhuma imagem é reescrita).
#VITE_IMAGE_CDN=wsrv

# ─── Mapas (src/lib/maps) ───────────────────────────────────────────────
# 100% OpenStreetMap, gratuito e sem chaves — funciona sem nada definido:
# mapa Leaflet + tiles OSM, moradas pelo Photon, rotas pelo OSRM. As
# instâncias públicas pedem uso moderado; com volume, apontar para
# instâncias próprias (Photon e OSRM correm em Docker, sem licença).

# Autocomplete / geocoding (Photon). Vazio = https://photon.komoot.io
#VITE_GEOCODER_URL=

# Rotas (OSRM). Vazio = https://router.project-osrm.org
#VITE_ROUTING_URL=

# Tiles do mapa. Vazio = tiles do OpenStreetMap.
#VITE_MAP_TILES_URL=

# Proxy de mapas do nosso backend (MapsController) — com isto, as rotas
# passam pelo backend (cache + User-Agent), em vez de irem direto ao OSRM.
#VITE_MAPS_API_BASE=http://localhost:8000/api/v1/maps

# ─── API real (backend/) ────────────────────────────────────────────────
# Sem backend implantado ainda (ver plano de backend) — os 3 fluxos de
# login (cliente/restaurante/sistema) chamam esta API e falham com erro de
# rede enquanto não houver um servidor a responder aqui.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Client ID Web do Google OAuth (login de cliente, src/routes/entrar.tsx) —
# criado na Google Cloud Console. Sem isto, o botão "Continuar com Google"
# não consegue iniciar o fluxo (ver src/lib/google-identity.ts). Usado
# também pela app nativa (Android/iOS) — ver capacitor/README.md, secção
# "Login com Google (nativo)", que precisa de mais config fora daqui.
VITE_GOOGLE_WEB_CLIENT_ID=

# Notificações push no browser (Web Push, src/lib/push-notifications.tsx) —
# chave PÚBLICA VAPID, tem de ser a mesma do backend (VAPID_PUBLIC_KEY em
# backend/.env, ver config/services.php lá). Não é secreta — viaja para o
# browser (é o que o Push API usa para o utilizador confiar nas mensagens
# que só o nosso servidor, com a chave privada, consegue assinar). Sem
# isto, o botão de ativar notificações fica escondido.
VITE_VAPID_PUBLIC_KEY=

# Tempo real (Reverb, src/lib/echo.ts) — a chave PÚBLICA do Reverb
# (REVERB_APP_KEY em backend/.env, não é secreta, viaja para o browser).
# Sem isto, a app continua a funcionar normalmente — só o poll periódico
# de 30s deixa de ter reforço em tempo real (ver `getEcho`, nunca lança,
# só regista um aviso na consola).
#
# Em produção, o processo `reverb` do Fly está exposto numa porta PRÓPRIA
# (6001, ver fly.toml/[[services]]) — nunca 443, que é só o processo
# `app` (Laravel). O backend fala com o Reverb por dentro (rede privada
# do Fly, REVERB_HOST=reverb.process.luku-api.internal); o browser fala
# com ele por fora, por aqui, com a porta pública:
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=https

# ─── Ambiente de teste local partilhado (mock-server/) ──────────────────
# Liga esta aba a um servidor local que guarda os dados mock (restaurantes,
# pedidos, reservas, avaliações, etc.) partilhados entre vários
# dispositivos na mesma rede — ver mock-server/README.md. Nada a ver com
# VITE_API_BASE_URL/backend real. Vazio = comportamento de sempre (mock só
# neste browser, via localStorage) — é o que Vercel/produção usam sempre.
#VITE_SHARED_MOCK_URL=http://192.168.1.194:4001
