# Copiar para `.env.local` (não versionado) e preencher conforme necessário.
# Todas as variáveis do cliente têm de começar por `VITE_`.

# Base absoluta usada para gerar o link do QR code do cardápio
# (src/components/menu-qr-dialog.tsx). Em dev, o IP desta máquina na rede
# local para o QR poder ser lido pelo telemóvel.
VITE_PUBLIC_BASE_URL=http://192.168.1.194:8081

# Proxy de redimensionamento de imagens (src/lib/image-cdn.ts).
# Sem valor = identidade (nenhuma imagem é reescrita).
#VITE_IMAGE_CDN=wsrv

# ─── Mapas (src/lib/maps) ───────────────────────────────────────────────
# Sem nada disto, o app usa Leaflet + OpenStreetMap e distância haversine
# (comportamento atual). Ligar a Google é aditivo.

# "google" liga o caminho Google. Qualquer outro valor / vazio = "leaflet".
#VITE_MAPS_PROVIDER=google

# Chave de BROWSER da Google Maps Platform (restrita por HTTP referrer).
# Serve só para RENDERIZAR o mapa (Maps JavaScript API / tiles).
#VITE_GOOGLE_MAPS_API_KEY=

# Base do backend-proxy que fala com Geocoding / Routes / Distance Matrix.
# A chave de SERVIDOR e o cache vivem nesse backend, nunca no cliente.
# Enquanto vazio, geocoding/rotas reais ficam desligados e usa-se o
# cálculo local — ver src/lib/maps/google-client.ts para o contrato.
#VITE_MAPS_API_BASE=https://api.luku.com/maps
