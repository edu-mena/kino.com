APP_NAME=Luku
APP_ENV=local
APP_KEY=base64:krKXGQvqESXcERymi8BHUMz6yyeBlFXKqK52E9XJ2r4=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=luku
DB_USERNAME=luku
DB_PASSWORD=luku

# Sessão só é usada para o Horizon/Reverb dashboard local, nunca para auth da
# API (essa é sempre Sanctum Bearer token — ver config/sanctum.php).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=luku_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Índices separados por responsabilidade (ver plano) — evita que um FLUSHDB
# de cache limpe filas/broadcast por engano.
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_DB=2
REDIS_QUEUE_CONNECTION=queue

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responder@luku.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (S3-compatível) — disco "r2" em config/filesystems.php.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=luku-media
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# Domínio público (CDN) servido pelo Cloudflare em frente ao bucket R2 — ver
# secção "Imagens/vídeos" do plano.
R2_PUBLIC_URL=https://cdn.luku.com

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=244101
REVERB_APP_KEY=zygfmne1elgnzsex0nnk
REVERB_APP_SECRET=7d6vs9af5fpbmhuijdeq
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Google OAuth (login de cliente) — ver AuthController::googleCallback.
# 3 client_ids (um por plataforma, ver config/services.php) — o secret só
# existe para o Web (authorization-code flow), Android/iOS não usam.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nome exibido no token Sanctum quando o cliente não manda um (ver
# AuthController) + duração default de token (minutos) — null = sem expiração
# automática, mas todo token pode ser revogado via /auth/logout(-all).
SANCTUM_TOKEN_EXPIRATION_MINUTES=129600

# Alerta de segurança do login de sistema (ver SystemSecurityAlertMail) —
# recebe um email a CADA acesso a /sistema/entrar e a cada tentativa de
# login de operador, com um link para bloquear o IP com um clique.
SECURITY_ALERT_EMAIL=

# Aviso automático para a equipa a cada candidatura de parceiro (ver
# PartnerApplicationReceivedMail) — o candidato recebe a SUA própria
# confirmação à parte, sempre no email que ele próprio submeteu.
PARTNERS_NOTIFICATION_EMAIL=
