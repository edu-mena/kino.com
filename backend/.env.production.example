# Modelo das variáveis a definir como SEGREDOS no Fly (`fly secrets set
# CHAVE=valor`, nunca commitadas) — não é um `.env` para copiar direto,
# é a checklist do que falta preencher. Ver DEPLOY.md para o procedimento
# completo, passo a passo.

APP_NAME=Luku
APP_ENV=production
APP_KEY=                      # gerar com `php artisan key:generate --show` e colar aqui
APP_DEBUG=false
APP_URL=https://luku-api.fly.dev        # ou https://api.luku.ao, depois de apontar o CNAME
FRONTEND_URL=https://luku.ao
APP_TIMEZONE=UTC
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=error

# Preenchido automaticamente como secret pelo `fly postgres attach` —
# copiar o valor que o comando imprime para DB_URL (o config já sabe usar
# DB_URL em vez de DB_HOST/DB_PORT/... separados, ver config/database.php).
DB_CONNECTION=pgsql
DB_URL=

# Idem para Redis — `fly redis create` (Upstash) imprime uma REDIS_URL.
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_QUEUE_CONNECTION=queue

SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=luku_cache

MAIL_MAILER=smtp                # trocar por um SMTP real (ex.: Resend, Postmark, SES) — mailhog só existe em dev
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responder@luku.ao"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 — mesmas credenciais em dev e produção (bucket já existe
# desde a Fase 4), só confirmar que R2_PUBLIC_URL aponta ao domínio certo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=luku-media
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
R2_PUBLIC_URL=https://cdn.luku.ao

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=luku-api.fly.dev    # ajustar se usar api.luku.ao
REVERB_PORT=443
REVERB_SCHEME=https

# Google OAuth de PRODUÇÃO — client_ids/secret distintos dos usados em dev
# (o projeto Google Cloud deve ter o redirect/origin de luku.ao autorizado).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SANCTUM_TOKEN_EXPIRATION_MINUTES=129600

# Alerta de segurança do login de sistema — ver .env.example para detalhe.
# Em produção, DEVE ser um email lido de verdade (o teu, ou uma lista de
# distribuição da equipa) — sem isto, cai no MAIL_FROM_ADDRESS genérico e
# ninguém vê os alertas.
SECURITY_ALERT_EMAIL=
